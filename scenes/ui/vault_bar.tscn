[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/vault_bar.gd" id="1_vault"]

[node name="VaultBar" type="PanelContainer"]
mouse_filter = 2
script = ExtResource("1_vault")

[node name="VaultMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 4

[node name="VaultContent" type="VBoxContainer" parent="VaultMargin"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="VaultLabel" type="RichTextLabel" parent="VaultMargin/VaultContent"]
layout_mode = 2
bbcode_enabled = true
scroll_active = false
fit_content = true
text = "Energie: 50  |  Biomasse: 50  |  Exotisch: 30  |  Material: 30  |  Volatil: 30"
horizontal_alignment = 1
mouse_filter = 2

[node name="CreditLabel" type="RichTextLabel" parent="VaultMargin/VaultContent"]
layout_mode = 2
bbcode_enabled = true
scroll_active = false
fit_content = true
text = "Credits: 100"
horizontal_alignment = 1
mouse_filter = 2

[node name="TransportStatusLabel" type="RichTextLabel" parent="VaultMargin/VaultContent"]
layout_mode = 2
bbcode_enabled = true
scroll_active = false
fit_content = true
text = "Transport: keine aktiven Routen"
horizontal_alignment = 1
mouse_filter = 2

[node name="IncomeRateLabel" type="RichTextLabel" parent="VaultMargin/VaultContent"]
layout_mode = 2
bbcode_enabled = true
scroll_active = false
fit_content = true
text = "Einkommen: wartet auf Tick"
horizontal_alignment = 1
mouse_filter = 2
