[ext_resource type="Script" path="res://scripts/config/planet_detail_definition.gd" id="2_definition"]
[ext_resource type="Resource" path="res://resources/config/planet_details/satellite.tres" id="3_satellite"]
[ext_resource type="Resource" path="res://resources/config/planet_details/asteroid_belt.tres" id="4_belt"]
