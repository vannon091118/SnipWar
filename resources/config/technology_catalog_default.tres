[resource]
script = ExtResource("1_catalog")
technologies = [SubResource("Tech_shipyard_construction"), SubResource("Tech_scout_hull"), SubResource("Tech_scanner_drone"), SubResource("Tech_weapon_systems"), SubResource("Tech_worker_automation"), SubResource("Tech_mech_frame"), SubResource("Tech_planetary_survey"), SubResource("Tech_planetary_extraction"), SubResource("Tech_advanced_propulsion"), SubResource("Tech_heavy_armor_plating"), SubResource("Tech_deep_scan"), SubResource("Tech_long_range_sensors"), SubResource("Tech_automated_refinery"), SubResource("Tech_bulk_processing")]
