[sub_resource type="Resource" id="Tech_shipyard_construction"]
script = ExtResource("2_definition")
id = &"shipyard_construction"
display_name = "Orbitales Werft-Design"
description = "Erlaubt den Bau einer ersten orbitalen Werft am eigenen Startplaneten."
strategic_role = &"infrastructure"
visual_asset = ExtResource("8_shipyard")
effect_id = &"shipyard_construction"
mechanic_description = "Mechanik: Der Ausbau Orbitale Werft wird im Planetennetz freigeschaltet."
research_time = 15.0

[sub_resource type="Resource" id="Tech_scout_hull"]
script = ExtResource("2_definition")
id = &"scout_hull"
display_name = "Aufklärungsrumpf T1"
description = "Freischaltung eines leichten Tier-1-Scout-Schiffes mit Scanner-Aufhängung."
cost_resource = &"material"
cost_amount = 15
strategic_role = &"exploration"
prerequisite_tech_id = &"shipyard_construction"
visual_asset = ExtResource("3_scout_hull")
effect_id = &"scout_hull"
mechanic_description = "Mechanik: ShipManager erlaubt danach den Bau eines Tier-1-Scout-Schiffs."
research_time = 16.0

[sub_resource type="Resource" id="Tech_scanner_drone"]
script = ExtResource("2_definition")
id = &"scanner_drone"
display_name = "Scanner-Drohne T1"
description = "Montierbare Scanner-Drohne; entdeckt unbekannte Planeten bei Ankunft."
strategic_role = &"exploration"
prerequisite_tech_id = &"scout_hull"
visual_asset = ExtResource("4_scanner")
effect_id = &"scanner_drone"
mechanic_description = "Mechanik: Das persistente Forschungsschiff scannt bei Abschluss einer Forschungsmission den Zielplaneten."
research_time = 15.0

[sub_resource type="Resource" id="Tech_weapon_systems"]
script = ExtResource("2_definition")
id = &"weapon_systems"
display_name = "Waffensysteme T1"
description = "Schaltet Bordwaffen frei; aus einem Montageauftrag wird ein militärisches Schiff."
cost_resource = &"volatile"
cost_amount = 12
strategic_role = &"combat"
prerequisite_tech_id = &"shipyard_construction"
visual_asset = ExtResource("5_mech")
effect_id = &"weapon_systems"
mechanic_description = "Mechanik: Waffenbauteile und der Tier-2-Mehrzweckrumpf werden in der Schiffswerft kaufbar."
research_time = 18.0

[sub_resource type="Resource" id="Tech_worker_automation"]
script = ExtResource("2_definition")
id = &"worker_automation"
display_name = "Werft-Arbeiterautomatik"
description = "Nach dem ersten Scan kann die Werft einen Worker-Fertiger aktivieren."
cost_resource = &"biomass"
cost_amount = 15
strategic_role = &"economy"
prerequisite_tech_id = &"scanner_drone"
requires_discovery = true
visual_asset = ExtResource("3_scout_hull")
effect_id = &"worker_automation"
mechanic_description = "Mechanik: Die erste Worker-Fabrik wird baubar und startet langsamen automatischen Nachschub."
research_time = 16.0

[sub_resource type="Resource" id="Tech_mech_frame"]
script = ExtResource("2_definition")
id = &"mech_frame"
category = &"mech"
display_name = "Mech-Chassis T1"
description = "Grundrahmen für Layer-3-Mechs."
cost_resource = &"volatile"
cost_amount = 25
strategic_role = &"combat"
visual_asset = ExtResource("5_mech")
effect_id = &"mech_frame_layer3"
mechanic_description = "Mechanik: Layer-3-Chassis wird registriert; der taktische Mech-Kampf bleibt bis Layer 3 inert."
research_time = 20.0

[sub_resource type="Resource" id="Tech_planetary_survey"]
script = ExtResource("2_definition")
id = &"planetary_survey"
category = &"planet"
display_name = "Planetare Vermessung"
description = "Analysiert die lokale Signatur eines bekannten eigenen Planeten."
cost_resource = &"rare"
strategic_role = &"exploration"
visual_asset = ExtResource("6_planet_survey")
effect_id = &"planet_production_survey"
mechanic_description = "Mechanik: Die Ressourcenproduktion dieses Planeten steigt auf 125 %."
production_multiplier = 1.25
research_time = 15.0

[sub_resource type="Resource" id="Tech_planetary_extraction"]
script = ExtResource("2_definition")
id = &"planetary_extraction"
category = &"planet"
display_name = "Planetare Extraktion"
description = "Baut die Vermessung zu einer spezialisierten Förderkette aus."
