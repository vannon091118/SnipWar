[sub_resource type="Resource" id="Tech_drone_swarm"]
script = ExtResource("2_definition")
id = &"drone_swarm"
category = &"drones"
display_name = "Drohnenschwarm T1"
description = "Verbinder Mech- und Schiffs-Forschung: öffnet den verzweigten Drohnen-Techbaum und macht Drohnen-Module montierbar."
