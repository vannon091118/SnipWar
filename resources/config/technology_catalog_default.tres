mechanic_description = "Mechanik: Die Ressourcenproduktion dieses Planeten steigt zusätzlich auf 150 %."
production_multiplier = 1.5
research_time = 30.0

[sub_resource type="Resource" id="Tech_advanced_propulsion"]
script = ExtResource("2_definition")
id = &"advanced_propulsion"
display_name = "Fortschrittlicher Antrieb"
description = "Optimiert die Schiffsfahrt und schaltet das Reaktormodul frei."
