effect_id = &"advanced_propulsion"
mechanic_description = "Mechanik: +15 % Schiffsfahrt; das Reaktor-Modul wird in der Werft verfügbar."
research_time = 30.0

[sub_resource type="Resource" id="Tech_heavy_armor_plating"]
script = ExtResource("2_definition")
id = &"heavy_armor_plating"
