# Godot 4+ specific ignores
.godot/
/android/
godot/
*.exe

# Accidental nested/exported repository copies and local snapshot folders.
/res*/
/snapshots/
/dev-logs/

.freebuff/

# Local agent workspaces and session artifacts (never publish).
.agents/
.hermes/
/.agent-activity/
.kilo/

# Ad-hoc development artifacts never belong in the repository.
/tmp_*
*_check.py
*.zip
*.zip.*
/_mcp_*
/_ux_report_*

# Windows `> nul` redirect leftovers and scratch/dev leftovers (never commit).
/nul
/scratch_debug.gd
/scratch_debug.gd.uid
/scripts/_sentiment_compare.py
/test_mcp_input.json
/test_mcp_input.ndjson

node_modules/

# DOKI CommitLayer — transiente Flow-Artefakte (nie committen)
# Aber: .doki/change_index.json und .doki/narrative_chain.json
# sind persistente Artefakte und MÜSSEN committet werden.
/.doki/session.json
/.doki/owner.json
/.doki/session.lock
/.doki/prompt.txt
/.doki/narrator_body.md
/.doki/block_report.md
/.doki/recovery_log.json
/.doki/scope.json
/.doki/agent_binding.json
/.commit_msg.txt

# Narrative Runtime (Python) — abgeleiteter State (jederzeit aus der Chain rekonstruierbar)
narrative_runtime/state/
__pycache__/
*.pyc
