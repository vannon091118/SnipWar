# Godot 4+ specific ignores
.godot/
/android/
godot/
*.exe

# Accidental nested/exported repository copies and local snapshot folders.
/res*/
/snapshots/
/dev-logs/

.freebuff/

# Local agent workspaces and session artifacts (never publish).
.agents/
.hermes/
.kilo/

# Ad-hoc development artifacts never belong in the repository.
/tmp_*
*_check.py
*.zip
*.zip.*
/_mcp_*
/_ux_report_*
