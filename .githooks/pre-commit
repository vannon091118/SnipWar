#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

if [ -n "${GODOT_BIN:-}" ]; then
	godot_bin=$GODOT_BIN
else
	godot_bin=$(command -v godot || command -v godot4 || true)
fi

git diff --cached --check

if [ -z "$godot_bin" ] || [ ! -x "$godot_bin" ]; then
	printf 'Godot executable not found: set GODOT_BIN to the console binary (or put godot on PATH).\n' >&2
	exit 1
fi

# 0) AgentGate — Datei-Check-In/Kollision/Drift vor allen weiteren Gates.
if ! bash "$repo_root/scripts/agent_activity.sh" run-preflight; then
	printf '\nAgentGate blockiert den Commit. Remedy: check-in/update/recheck-in --audit.\n' >&2
	exit 1
fi

# 1) Preflight-Gate — Session-Scoped (nur wenn ein DOKI-Scope-Manifest vorliegt).
# Python-only Änderungen bleiben bewusst bei den mechanischen/DOKI-Gates;
# Scene-Preflight wird nur für code-relevante Änderungen gestartet.
severity=$(bash "$repo_root/scripts/agent_activity.sh" classify-staged)
scope_file="$repo_root/.doki/scope.json"
if [ "$severity" != python ]; then
	if [ -f "$scope_file" ]; then
		"$godot_bin" --headless --path "$repo_root" --script res://scripts/preflight.gd --scope="$scope_file"
	else
		"$godot_bin" --headless --path "$repo_root" --script res://scripts/preflight.gd
	fi
else
	printf 'Preflight: cheap path (python-only staged changes)\n'
fi

# 2) Mechanische Gates (unabhängig, jedes mit eigenem Evidence-Artfakt in user://mcp_evidence/)
for gate in scripts/testing/chain_manifest_gate.gd scripts/testing/compile_gate.gd scripts/testing/chain_validate_entry_test.gd; do
	if ! "$godot_bin" --headless --path "$repo_root" --script "res://$gate"; then
		printf '\nGate blockiert den Commit: %s\nEvidence: user://mcp_evidence/\n' "$gate" >&2
		exit 1
	fi
done

# 3) DOKI-Gate (nur wenn initialisiert)
if [ -f "$repo_root/scripts/doki/doki.gd" ]; then
	if ! "$godot_bin" --headless --path "$repo_root" --script res://scripts/doki/doki.gd -- gate --repo "$repo_root"; then
		printf '\nDOKI-Gate blockiert den Commit — Ablauf: git add → doki prepare → doki finish → git commit -F .commit_msg.txt\n' >&2
		exit 1
	fi
fi