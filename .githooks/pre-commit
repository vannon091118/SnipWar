#!/usr/bin/env bash
set -euo pipefail

# SnipWar pre-commit hook
# Runs: DOKI prepare + gate → Unified Check (compile + preflight + tests, scope-kontrolliert)
# Exits 1 if GODOT_BIN not available or any check fails

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT_DIR" ]; then
    echo "ERROR: Not in a git repository" >&2
    exit 1
fi

cd "$ROOT_DIR"

# Check for GODOT_BIN availability
if [ -z "${GODOT_BIN:-}" ] || [ ! -x "${GODOT_BIN}" ]; then
    echo "ERROR: GODOT_BIN not set or not executable (required for pre-commit gate)" >&2
    echo "Set: export GODOT_BIN=/path/to/godot_console" >&2
    exit 1
fi

# Function to run Godot headless scripts
run_godot() {
    local script="$1"
    shift
    "$GODOT_BIN" --headless --path . --script "$script" "$@"
}

# Determine severity from agent_activity.sh classify_staged
SEVERITY="full"
if [ -f "scripts/agent_activity.sh" ]; then
    CLASSIFIED_SEVERITY=$(bash scripts/agent_activity.sh classify-staged 2>/dev/null || echo "full")
    case "$CLASSIFIED_SEVERITY" in
        python|scoped|full) SEVERITY="$CLASSIFIED_SEVERITY" ;;
        *) SEVERITY="full" ;;
    esac
    echo "=== pre-commit: Staged changes classified as severity=$SEVERITY ==="
fi

echo "=== pre-commit: DOKI prepare ==="
run_godot "res://scripts/doki/doki.gd" -- prepare "pre-commit gate" || {
    echo "ERROR: DOKI prepare failed" >&2
    exit 1
}

echo "=== pre-commit: DOKI gate ==="
run_godot "res://scripts/doki/doki.gd" -- gate || {
    echo "ERROR: DOKI gate failed" >&2
    exit 1
}

echo "=== pre-commit: Unified Check (compile + preflight + tests, scope=$SEVERITY) ==="
if [ "$SEVERITY" = "python" ]; then
    # Cheap path: compile + pure constraints only, no tests
    run_godot "res://scripts/check.gd" --cheap-path --skip-tests -x || {
        echo "ERROR: Unified Check (cheap path) failed" >&2
        exit 1
    }
else
    # Full path: compile + preflight + tests, scope-gefiltert aus staged files
    run_godot "res://scripts/check.gd" -x || {
        echo "ERROR: Unified Check failed" >&2
        exit 1
    }
fi

echo "=== pre-commit: All checks passed ==="
exit 0
