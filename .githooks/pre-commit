#!/usr/bin/env bash
set -euo pipefail

# SnipWar pre-commit hook
# Runs: DOKI gate (Session verified? Snapshot-Match? .commit_msg.txt?) →
#       Verification driver (compile + preflight + tests, scope-kontrolliert)
#       Der Treiber ist ein externes Python-Skript (scripts/verify.py); die
#       Engine orchestriert nicht mehr selbst und hält kein eigenes Lock.
# Exits 1 if GODOT_BIN not available or any check fails
#
# Der DOKI-Ablauf ist laut AGENTS.md/README: git add → doki prepare →
# body schreiben → doki finish → git commit -F .commit_msg.txt. prepare und
# finish macht der AGENT manuell; der pre-commit-Hook feuert das DOKI-Gate
# (prüft verified + Snapshot + Coverage + .commit_msg.txt), KEIN zweites
# prepare (das würde die bereits verified Session überschreiben).

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT_DIR" ]; then
    echo "ERROR: Not in a git repository" >&2
    exit 1
fi

cd "$ROOT_DIR"

# Content-neutraler Merge: Der Branch ist ein Superset des Base, der Merge
# committet KEINE neue Arbeit (Staged-Diff leer) — er zeichnet nur die
# Konvergenz mit dem Base auf (z.B. um einen CONFLICTING-PR-Status zu klären).
# Der DOKI-Gate erkennt dies via merge-noop; der Verify-Treiber hätte keinen
# Staged-Scope und würde sonst einen unnötigen Voll-Lauf starten, weshalb er
# für diesen Fall übersprungen wird. Ein Merge MIT echten Konflikt-Änderungen
# (Staged nicht leer) läuft weiterhin vollständig durch alle Gates.
MERGE_HEAD_PATH="$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)"
SKIP_VERIFY=0
if [ -n "$MERGE_HEAD_PATH" ] && [ -f "$MERGE_HEAD_PATH" ] && [ -z "$(git diff --cached --name-only)" ]; then
    SKIP_VERIFY=1
fi

# Check for GODOT_BIN availability
if [ -z "${GODOT_BIN:-}" ] || [ ! -x "${GODOT_BIN}" ]; then
    echo "ERROR: GODOT_BIN not set or not executable (required for pre-commit gate)" >&2
    echo "Set: export GODOT_BIN=/path/to/godot_console" >&2
    exit 1
fi

# Function to run Godot headless scripts
run_godot() {
    local script="$1"
    shift
    "$GODOT_BIN" --headless --path . --script "$script" "$@"
}

# Function to run the external verification driver (owns the OS-level lock,
# scope resolution, compile gate, preflight, and test orchestration)
run_verify() {
    shift_args=()
    for arg in "$@"; do shift_args+=("$arg"); done
    python scripts/verify.py "${shift_args[@]}"
}

# Determine severity from agent_activity.sh classify_staged
SEVERITY="full"
if [ -f "scripts/agent_activity.sh" ]; then
    CLASSIFIED_SEVERITY=$(bash scripts/agent_activity.sh classify-staged 2>/dev/null || echo "full")
    case "$CLASSIFIED_SEVERITY" in
        python|scoped|full) SEVERITY="$CLASSIFIED_SEVERITY" ;;
        *) SEVERITY="full" ;;
    esac
    echo "=== pre-commit: Staged changes classified as severity=$SEVERITY ==="
fi

# Phase 0 guard: reject staged sets spanning disjoint atomic commit groups
# (AGENTS.md table). Escape hatch: --allow-multi with a reason + [TAKEOVER:...]
# trailer in the commit body.
echo "=== pre-commit: Commit-group guard ==="
bash scripts/commit_group_guard.sh check || {
    echo "ERROR: Commit spans multiple atomic commit groups" >&2
    exit 1
}

echo "=== pre-commit: DOKI gate ==="
run_godot "res://scripts/doki/doki.gd" -- gate || {
    echo "ERROR: DOKI gate failed" >&2
    exit 1
}

if [ "$SKIP_VERIFY" -eq 1 ]; then
    echo "=== pre-commit: Content-neutraler Merge — Verify-Treiber übersprungen (kein Staged-Inhalt) ==="
else
    echo "=== pre-commit: Verification driver (compile + preflight + tests, scope=$SEVERITY) ==="
    if [ "$SEVERITY" = "python" ]; then
        # Cheap path: compile + pure constraints only, no tests
        run_verify --cheap-path --skip-tests --fail-fast || {
            echo "ERROR: Verification driver (cheap path) failed" >&2
            exit 1
        }
    else
        # Full path: compile + preflight + tests, scope-gefiltert aus staged files
        run_verify --fail-fast || {
            echo "ERROR: Verification driver failed" >&2
            exit 1
        }
    fi
fi

echo "=== pre-commit: All checks passed ==="
exit 0
