#!/usr/bin/env bash
set -euo pipefail

# SnipWar post-commit hook
# Runs DOKI finalize (non-blocking - logs errors but doesn't fail the commit)
# If GODOT_BIN not available, skips finalize but still allows push

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT_DIR" ]; then
    echo "ERROR: Not in a git repository" >&2
    exit 0
fi

cd "$ROOT_DIR"

# Check for GODOT_BIN availability
if [ -z "${GODOT_BIN:-}" ] || [ ! -x "${GODOT_BIN}" ]; then
    echo "WARN: GODOT_BIN not set or not executable — skipping DOKI finalize" >&2
    exit 0
fi

# Function to run Godot headless scripts
run_godot() {
    local script="$1"
    shift
    "$GODOT_BIN" --headless --path . --script "$script" "$@"
}

echo "=== post-commit: DOKI finalize ==="
run_godot "res://scripts/doki/doki.gd" -- finalize || {
    echo "ERROR: DOKI finalize failed (non-blocking, but push may be affected)" >&2
    # Non-blocking: don't exit 1, just log the error
}

echo "=== post-commit: DOKI finalize completed ==="
exit 0