#!/usr/bin/env bash
set -euo pipefail

# SnipWar commit-msg hook
# Validates ONLY the commit message text — kein DOKI-Validierungsschritt mehr
# (DOKI ist seit der Entkopplung ein externes System, docs/DOKI_PIN.md; die
# Message-Erzeugung liegt beim Agent über das gepinnte Home).
# Exits 1 on a forbidden trailer.

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT_DIR" ]; then
    echo "ERROR: Not in a git repository" >&2
    exit 1
fi

cd "$ROOT_DIR"

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    echo "ERROR: Commit message file not provided" >&2
    exit 1
fi

# ─── Bot-Trailer-Verbot (Vannon-Regel: NIEMALS in einer Commit-Message) ─────
# Der Header wird NICHT bereinigt oder toleriert: jeder Codebuff-Trailer
# verwirft den Commit. So kann kein verbotener Header trotz Hook-Fehler oder
# Encoding-/Whitespace-Variante in der Historie landen.
if grep -qE 'Generated[[:space:]]+with[[:space:]]+Codebuff\b|Co-Authored-By:[[:space:]]*Codebuff\b' "$MSG_FILE"; then
    echo "ERROR: Verbotener Codebuff-Header erkannt — Commit abgelehnt." >&2
    echo "Ausschließlich DOKI-Narrator-Prompting (über das gepinnte Home) ist zulässig; Trailer entfernen und erneut erstellen." >&2
    exit 1
fi

exit 0