#!/usr/bin/env bash
set -euo pipefail

# SnipWar commit-msg hook
# Validates commit message via DOKI finish (blocking)
# Exits 1 if GODOT_BIN not available or validation fails

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT_DIR" ]; then
    echo "ERROR: Not in a git repository" >&2
    exit 1
fi

cd "$ROOT_DIR"

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    echo "ERROR: Commit message file not provided" >&2
    exit 1
fi

# ─── Bot-Trailer-Verbot (Vannon-Regel: NIEMALS in einer Commit-Message) ─────
# Der Header wird NICHT bereinigt oder toleriert: jeder Codebuff-Trailer
# verwirft den Commit. So kann kein verbotener Header trotz Hook-Fehler oder
# Encoding-/Whitespace-Variante in der Historie landen.
if grep -qE 'Generated[[:space:]]+with[[:space:]]+Codebuff\b|Co-Authored-By:[[:space:]]*Codebuff\b' "$MSG_FILE"; then
    echo "ERROR: Verbotener Codebuff-Header erkannt — Commit abgelehnt." >&2
    echo "Ausschließlich DOKI-Narrator-Prompting ist zulässig; Trailer entfernen und erneut über DOKI erstellen." >&2
    exit 1
fi

# Check for GODOT_BIN availability
if [ -z "${GODOT_BIN:-}" ] || [ ! -x "${GODOT_BIN}" ]; then
    # Bei DOKI-Commits (erkennbar an [NARRATOR:]) ist GODOT_BIN Pflicht
    if grep -q '\[NARRATOR:' "$MSG_FILE" 2>/dev/null; then
        echo "ERROR: GODOT_BIN nicht verfuegbar — DOKI-Commit kann nicht validiert werden." >&2
        exit 1
    fi
    echo "WARN: GODOT_BIN not set or not executable — skipping DOKI verify-only" >&2
    exit 0
fi

# Function to run Godot headless scripts
run_godot() {
    local script="$1"
    shift
    "$GODOT_BIN" --headless --path . --script "$script" "$@"
}

# Read the commit message
COMMIT_MSG="$(cat "$MSG_FILE")"

# ─── Transport-Commit-Erkennung (TASK-015) ─────────────────────────────────
# Ein Commit, der NUR auto-managed DOKI-Artefakte enthält (finalize-Produkte:
# narrative_chain.json, change_index.json, CHANGELOG.md, arcs.json), ist ein
# TRANSPORT-Commit — er transportiert fertige Artefakte, erzeugt keine neue
# Arbeit. Er braucht KEINE DOKI-Tokens und keine Message-Validierung.
# Ohne diese Ausnahme entsteht der finalize-Loop: finalize staged Artefakte →
# Commit braucht Tokens → Tokens nur via prepare/finish → neuer Chain-Eintrag
# → finalize schreibt wieder Artefakte → Endlosschleife.
TRANSPORT_COMMIT=1
while IFS= read -r staged_file; do
    [ -z "$staged_file" ] && continue
    case "$staged_file" in
        .doki/narrative_chain.json|.doki/change_index.json|CHANGELOG.md|scripts/doki/data/arcs.json) ;;
        *) TRANSPORT_COMMIT=0; break ;;
    esac
done < <(git diff --cached --name-only)

if [ "$TRANSPORT_COMMIT" -eq 1 ]; then
    echo "=== commit-msg: Transport-Commit (nur DOKI-Artefakte) — Message-Validierung übersprungen ==="
    exit 0
fi

# Check if this is a DOKI commit (has the expected format)
# DOKI commits have a specific structure with [NARRATOR:], [MODEL:], [COMPOSITE:]
# im Body. WICHTIG: die Message beginnt mit dem Subject ("<Narrator> (N files): …"),
# erst danach folgen die Tokens — deshalb prüfen wir auf Vorhandensein im gesamten
# Text, NICHT auf Zeilenanfang (ein Anker an ^ verwarf jede echt generierte Message).
if echo "$COMMIT_MSG" | grep -q '\[NARRATOR:'; then
    echo "=== commit-msg: DOKI verify-only ==="
    # verify-only erwartet die Message-Datei als Positionsargument (<msgfile>),
    # nicht als --body-file. `$MSG_FILE` ist die temporäre Message-Datei, die
    # git dem commit-msg-Hook übergibt.
    run_godot "res://scripts/doki/doki.gd" -- verify-only "$MSG_FILE" || {
        echo "ERROR: DOKI commit message validation failed" >&2
        exit 1
    }
    echo "=== commit-msg: DOKI validation passed ==="
else
    echo "WARN: Commit message does not appear to be a DOKI-generated message" >&2
    echo "Expected format: [NARRATOR:...] [MODEL:...] [IMPULSE:...] [COMPOSITE:...]" >&2
    echo "Use DOKI prepare/finish to generate proper commit messages" >&2
    exit 1
fi

exit 0