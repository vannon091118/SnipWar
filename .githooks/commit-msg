#!/bin/sh
set -eu

message_file=$1
repo_root=$(git rev-parse --show-toplevel)

if [ -n "${GODOT_BIN:-}" ]; then
	godot_bin=$GODOT_BIN
else
	godot_bin=$(command -v godot || command -v godot4 || true)
fi

# Der awk-Begründungszeilen-Check ist entfallen:
# DOKI generiert die Begründungszeilen maschinell im .commit_msg.txt.

if [ -z "$godot_bin" ] || [ ! -x "$godot_bin" ]; then
	exit 0
fi

# Erneute Verifikation der Message (Checks 1-9, keine Nebenwirkungen).
if [ -f "$repo_root/scripts/doki/doki.gd" ]; then
	if ! "$godot_bin" --headless --path "$repo_root" --script res://scripts/doki/doki.gd -- verify-only "$message_file" --repo "$repo_root"; then
		printf '\nDOKI-Verify blockiert den Commit — die Message hat harte Fehler (Checks 7-9).\n' >&2
		exit 1
	fi
fi