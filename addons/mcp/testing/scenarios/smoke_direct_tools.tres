[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/gdscript_mcp/testing/mcp_test_scenario.gd" id="1_scenario"]

[resource]
script = ExtResource("1_scenario")
id = "smoke_direct_tools"
description = "Smoke test: direct tool calls without scene boot (headless-safe). Tests runtime_eval, engine_info, perf_metrics, object_counts."
scene_path = ""
wait_frames = 3
requires_renderer = false
enabled_by_default = true
steps = Array[Dictionary]([{
"tool": "runtime_eval",
"args": {"code": "2 * 21"},
"expect_key": "result",
"expect_op": "==",
"expect_value": 42
}, {
"tool": "runtime_engine_info",
"args": {},
"expect_key": "engine_version",
"expect_op": "contains",
"expect_value": "4."
}, {
"tool": "runtime_perf_metrics",
"args": {},
"expect_key": "fps",
"expect_op": ">",
"expect_value": 0.0
}, {
"tool": "runtime_get_scene_tree",
"args": {"max_depth": 2},
"expect_key": "tree",
"expect_op": "!=",
"expect_value": null
}])
